# Base URL of creative-nepal-api (Better Auth + REST endpoints live under /api)
NEXT_PUBLIC_API_URL=http://localhost:3333

# Server-side base URL for CMS content fetches (Server Components). Defaults to
# NEXT_PUBLIC_API_URL; set separately when the server reaches the API on an internal host.
API_URL=http://localhost:3333

# Canonical origin, used to build sitemap.xml entries
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- CMS ---------------------------------------------------------------------
# Must match creative-nepal-api. Unlocks unpublished drafts behind /api/preview.
CONTENT_PREVIEW_SECRET=
# Must match creative-nepal-api. Authenticates the revalidation ping from the API.
WEB_REVALIDATE_SECRET=
